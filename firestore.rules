rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      // User transactions
      match /transactions/{transactionId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(transactionId);
        allow update: if isOwner(userId) && isValidId(transactionId);
        allow delete: if isOwner(userId) && isValidId(transactionId);
      }

      // User custom categories
      match /categories/{categoryId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(categoryId);
        allow update: if isOwner(userId) && isValidId(categoryId);
        allow delete: if isOwner(userId) && isValidId(categoryId);
      }

      // User savings goals
      match /savingsGoals/{goalId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(goalId);
        allow update: if isOwner(userId) && isValidId(goalId);
        allow delete: if isOwner(userId) && isValidId(goalId);
      }
    }
  }
}
